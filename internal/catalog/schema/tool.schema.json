{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Developers' Club DX tool manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "category", "description", "version", "executables", "version_args", "platforms"],
  "anyOf": [
    { "required": ["installers"] },
    { "required": ["artifacts"] }
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/identifier" },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
    "description": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "upgrade_policy"],
      "properties": {
        "channel": { "type": "string", "minLength": 1 },
        "upgrade_policy": { "const": "never_automatically" }
      }
    },
    "executables": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_.+-]+$" } },
    "version_args": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
    "conflicts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
    "platforms": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "windows": { "$ref": "#/$defs/architectures" },
        "macos": { "$ref": "#/$defs/architectures" },
        "linux": { "$ref": "#/$defs/architectures" },
        "bsd": { "$ref": "#/$defs/architectures" }
      }
    },
    "installers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/installer" } },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "architectures": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["amd64", "arm64", "386", "arm", "riscv64"] } },
    "installer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "manager", "package_id", "scope", "source"],
      "properties": {
        "platform": { "enum": ["windows", "macos", "linux", "bsd"] },
        "manager": { "enum": ["winget", "scoop", "chocolatey", "homebrew", "macports", "apt", "dnf", "pacman", "zypper", "apk", "freebsd-pkg"] },
        "package_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@/-]{0,127}$" },
        "kind": { "enum": ["package", "cask"] },
        "scope": { "enum": ["user", "system"] },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture", "version", "url", "sha256", "size", "format", "archive_root"],
      "properties": {
        "platform": { "enum": ["windows", "macos", "linux", "bsd"] },
        "architecture": { "enum": ["amd64", "arm64", "386", "arm", "riscv64"] },
        "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "regional_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "format": { "enum": ["tar.gz", "zip"] },
        "archive_root": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*(/[A-Za-z0-9][A-Za-z0-9._+-]*)*$" },
        "allowed_redirect_hosts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*[A-Za-z0-9]$" } }
      }
    }
  }
}
